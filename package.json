{
  "name": "bpmsoft-intellisense",
  "displayName": "BPMSoft IntelliSense",
  "description": "Autocomplete and navigation for BPMSoft AMD modules in Pkg",
  "version": "1.2.5",
  "publisher": "kuzecowmihail",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:BPMSoft.Configuration/Pkg/**/*.js",
    "workspaceContains:BPMSoft.Configuration/Autogenerated/**/*.js",
    "workspaceContains:BPMSoft.Configuration/BPMSoft.Configuration.Dev.csproj",
    "workspaceContains:BPMSoft.Configuration/BPMSoft.Configuration.Dev.sln",
    "workspaceContains:BPMSoft.Configuration.Dev.csproj",
    "workspaceContains:BPMSoft.Configuration.Dev.sln",
    "workspaceContains:Pkg/**/Schemas/**/*.js",
    "workspaceContains:*/Schemas/**/*.js",
    "workspaceContains:Schemas/**/*.js",
    "workspaceContains:conf/content/*.js",
    "workspaceContains:content/*.js",
    "workspaceContains:Resources/ui/BPMSoft/**/*.js",
    "workspaceContains:ui/BPMSoft/**/*.js",
    "workspaceContains:Autogenerated/Src/*.js"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[javascript]": {
        "editor.wordBasedSuggestions": "off",
        "editor.suggestSelection": "first",
        "editor.suggest.showStatusBar": false,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "javascript.suggest.names": false,
        "javascript.suggestionActions.enabled": false
      }
    },
    "commands": [
      {
        "command": "bpmsoft.rebuildIndex",
        "title": "Rebuild Index",
        "category": "BPMSoft"
      },
      {
        "command": "bpmsoft.setDefaultFormatter",
        "title": "Set as Default Formatter (JS/C#/SQL)",
        "category": "BPMSoft"
      },
      {
        "command": "bpmsoft.schemaHistory.openDiff",
        "title": "Показать изменения коммита",
        "category": "BPMSoft"
      },
      {
        "command": "bpmsoft.schemaHistory.openCommit",
        "title": "Открыть коммит целиком",
        "category": "BPMSoft",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "bpmsoft.schemaHistory.refresh",
        "title": "Обновить Timeline",
        "category": "BPMSoft",
        "icon": "$(refresh)"
      },
      {
        "command": "bpmsoft.schemaHistory.pin",
        "title": "Timeline: закрепить текущий файл",
        "category": "BPMSoft",
        "icon": "$(pin)"
      },
      {
        "command": "bpmsoft.schemaHistory.unpin",
        "title": "Timeline: открепить",
        "category": "BPMSoft",
        "icon": "$(pinned)"
      },
      {
        "command": "bpmsoft.schemaHistory.toggleGitHistory",
        "title": "Git History",
        "category": "BPMSoft",
        "toggled": "bpmsoftSchemaHistoryGitEnabled"
      },
      {
        "command": "bpmsoft.schemaHistory.toggleLocalHistory",
        "title": "Local History",
        "category": "BPMSoft",
        "toggled": "bpmsoftSchemaHistoryLocalEnabled"
      },
      {
        "command": "bpmsoft.schemaHistory.findLocalHistory",
        "title": "Local History: найти запись для восстановления…",
        "category": "BPMSoft",
        "icon": "$(history)"
      },
      {
        "command": "bpmsoft.viewModelOutline.toggleFollowCursor",
        "title": "Следовать за курсором",
        "category": "BPMSoft",
        "toggled": "bpmsoftViewModelOutlineFollowCursor"
      },
      {
        "command": "bpmsoft.plainOutline.toggleFollowCursor",
        "title": "Следовать за курсором",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineFollowCursor"
      },
      {
        "command": "bpmsoft.plainOutline.toggleFilterOnType",
        "title": "Фильтрация при вводе",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineFilterOnType"
      },
      {
        "command": "bpmsoft.plainOutline.sortByPosition",
        "title": "По позиции",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineSortPosition"
      },
      {
        "command": "bpmsoft.plainOutline.sortByName",
        "title": "По имени",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineSortName"
      },
      {
        "command": "bpmsoft.plainOutline.sortByCategory",
        "title": "По категории",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineSortCategory"
      }
    ],
    "submenus": [
      {
        "id": "bpmsoft.schemaHistory.filterMenu",
        "label": "Источники Timeline",
        "icon": "$(filter)"
      },
      {
        "id": "bpmsoft.schemaHistory.moreActionsMenu",
        "label": "Дополнительно",
        "icon": "$(ellipsis)"
      },
      {
        "id": "bpmsoft.viewModelOutline.actionsMenu",
        "label": "Дополнительно",
        "icon": "$(ellipsis)"
      },
      {
        "id": "bpmsoft.plainOutline.actionsMenu",
        "label": "Дополнительно",
        "icon": "$(ellipsis)"
      },
      {
        "id": "bpmsoft.plainOutline.sortByMenu",
        "label": "Сортировка"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bpmsoft.schemaHistory.pin",
          "when": "view == bpmsoftSchemaHistory && !bpmsoftSchemaHistoryPinned",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.schemaHistory.unpin",
          "when": "view == bpmsoftSchemaHistory && bpmsoftSchemaHistoryPinned",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.schemaHistory.refresh",
          "when": "view == bpmsoftSchemaHistory",
          "group": "navigation@2"
        },
        {
          "submenu": "bpmsoft.schemaHistory.filterMenu",
          "when": "view == bpmsoftSchemaHistory",
          "group": "navigation@3"
        },
        {
          "submenu": "bpmsoft.schemaHistory.moreActionsMenu",
          "when": "view == bpmsoftSchemaHistory",
          "group": "navigation@4"
        },
        {
          "submenu": "bpmsoft.viewModelOutline.actionsMenu",
          "when": "view == bpmsoftViewModelOutline",
          "group": "navigation@1"
        },
        {
          "submenu": "bpmsoft.plainOutline.actionsMenu",
          "when": "view == bpmsoftPlainOutline",
          "group": "navigation@1"
        }
      ],
      "bpmsoft.viewModelOutline.actionsMenu": [
        {
          "command": "bpmsoft.viewModelOutline.toggleFollowCursor",
          "group": "1_navigation@1"
        }
      ],
      "bpmsoft.plainOutline.actionsMenu": [
        {
          "command": "bpmsoft.plainOutline.toggleFollowCursor",
          "group": "1_navigation@1"
        },
        {
          "command": "bpmsoft.plainOutline.toggleFilterOnType",
          "group": "1_navigation@2"
        },
        {
          "submenu": "bpmsoft.plainOutline.sortByMenu",
          "group": "2_sort@1"
        }
      ],
      "bpmsoft.plainOutline.sortByMenu": [
        {
          "command": "bpmsoft.plainOutline.sortByPosition",
          "group": "1_sortBy@1"
        },
        {
          "command": "bpmsoft.plainOutline.sortByName",
          "group": "1_sortBy@2"
        },
        {
          "command": "bpmsoft.plainOutline.sortByCategory",
          "group": "1_sortBy@3"
        }
      ],
      "bpmsoft.schemaHistory.filterMenu": [
        {
          "command": "bpmsoft.schemaHistory.toggleGitHistory",
          "group": "1_sources@1"
        },
        {
          "command": "bpmsoft.schemaHistory.toggleLocalHistory",
          "group": "1_sources@2"
        }
      ],
      "bpmsoft.schemaHistory.moreActionsMenu": [
        {
          "command": "bpmsoft.schemaHistory.findLocalHistory",
          "group": "1_localHistory@1"
        }
      ],
      "view/item/context": [
        {
          "command": "bpmsoft.schemaHistory.openCommit",
          "when": "view == bpmsoftSchemaHistory && viewItem == bpmsoftHistoryCommit",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "BPMSoft IntelliSense",
      "properties": {
        "bpmsoft.pkgGlob": {
          "type": "string",
          "default": "**/Pkg/**/Schemas/**/*.js",
          "description": "Glob for package schema JS files to index"
        },
        "bpmsoft.autogeneratedGlob": {
          "type": "string",
          "default": "**/Autogenerated/Src/*.js",
          "description": "Glob for locked/autogenerated schema JS (SchemaName.Package.js)"
        },
        "bpmsoft.platformUiGlob": {
          "type": "string",
          "default": "**/Resources/ui/BPMSoft/**/*.js",
          "description": "Glob for platform Ext UI classes (override/extend targets like BPMSoft.controls.Grid)"
        },
        "bpmsoft.enablePlatformStubs": {
          "type": "boolean",
          "default": true,
          "description": "Include static BPMSoft.* platform stubs in completions"
        },
        "bpmsoft.preferIndexedCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Disable JS word/name history suggestions in workspace so indexed BPMSoft completions rank first"
        },
        "bpmsoft.styleDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Check style in editable JS and C# files. JS skips Autogenerated / UI / conf. C# also checks Autogenerated/Src (opened by C# Dev Kit). JS: K&R, var/const, eqeqeq, unused locals and schema members, switch, curly braces, camelCase methods/locals. C#: Allman braces, if/switch, naming conventions."
        },
        "bpmsoft.csharpXmlDocDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Warn when a public/protected C# method or property has no /// XML-doc comment above it. Off by default: existing codebases rarely have full XML-doc coverage, so this would be noisy until you opt in."
        },
        "bpmsoft.trailingCommentDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a // comment (JS or C#) sits at the end of a code line instead of on its own line above, per the JS/C# style guides. Disable if this is too noisy on an existing codebase that hasn't followed the convention."
        },
        "bpmsoft.selectAllColumnsHint": {
          "type": "boolean",
          "default": true,
          "description": "Info-level hint on AddAllSchemaColumns()/FetchFromDB() without an explicit column list (C#) and esq.allColumns = true (JS): double-check you actually need every column. Silence a specific call site with a // bpmsoft-ignore: select-all-columns comment on the line above, or use the 'Not a problem' quick fix."
        },
        "bpmsoft.formatting.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Register BPMSoft's Format Document providers for JS/C#/SQL-script files (Prettier + our own style fixes for JS; brace/spacing/blank-line auto-fixes for C#; sql-formatter for Pkg/*/SqlScripts/*.sql). Works with the standard Format Document command / Shift+Alt+F / editor.formatOnSave. Turn off if you'd rather use another formatter for these languages."
        },
        "bpmsoft.namingDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Check client schema / C# schema / SQL script names against naming-guidelines.md (type-appropriate suffix, e.g. Section/SectionV2, Page/PageV2, Detail/DetailV2, and — only where the platform gives an unambiguous marker — Service/EventListener for C#). Surfaced both as squiggles on open descriptor.json/.cs files and in the 'BPMSoft: Naming Issues' view."
        },
        "bpmsoft.namingPrefixes": {
          "type": "string",
          "default": "",
          "description": "Comma-separated package/schema name prefixes to require (e.g. \"Nau\" or \"Nau,Go\" for multiple streams). Empty (default) disables the prefix check — there's no one universal prefix to assume."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bpmsoft",
          "title": "BPMSoft Settings",
          "icon": "media/bpmsoft-icon.svg"
        },
        {
          "id": "bpmsoftExplorer",
          "title": "BPMSoft Explorer",
          "icon": "media/bpmsoft-explorer-icon.svg"
        }
      ]
    },
    "views": {
      "bpmsoft": [
        {
          "id": "bpmsoftFormatting",
          "name": "Formatting"
        }
      ],
      "bpmsoftExplorer": [
        {
          "id": "bpmsoftViewModelOutline",
          "name": "ViewModel Outline"
        },
        {
          "id": "bpmsoftPlainOutline",
          "name": "Outline"
        },
        {
          "id": "bpmsoftSchemaHistory",
          "name": "Timeline"
        },
        {
          "id": "bpmsoftOpenSchemas",
          "name": "Open Schemas"
        },
        {
          "id": "bpmsoftPackages",
          "name": "Packages"
        },
        {
          "id": "bpmsoftNamingIssues",
          "name": "Naming Issues"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --skip-license",
    "smoke": "npm run compile && node scripts/run-smoke.js",
    "test:style": "tsc -p . && node scripts/test-style.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "acorn": "^8.11.3",
    "acorn-walk": "^8.3.2",
    "prettier": "^3.9.6",
    "sql-formatter": "^15.8.2"
  }
}
