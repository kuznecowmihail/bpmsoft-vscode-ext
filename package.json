{
  "name": "bpmsoft-toolkit",
  "displayName": "BPMSoft Toolkit",
  "description": "Autocomplete, navigation, localization and naming tools for BPMSoft AMD modules in Pkg",
  "version": "1.3.1",
  "publisher": "NAU",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:BPMSoft.Configuration/Pkg/**/*.js",
    "workspaceContains:BPMSoft.Configuration/Autogenerated/**/*.js",
    "workspaceContains:BPMSoft.Configuration/BPMSoft.Configuration.Dev.csproj",
    "workspaceContains:BPMSoft.Configuration/BPMSoft.Configuration.Dev.sln",
    "workspaceContains:BPMSoft.Configuration.Dev.csproj",
    "workspaceContains:BPMSoft.Configuration.Dev.sln",
    "workspaceContains:Pkg/**/Schemas/**/*.js",
    "workspaceContains:*/Schemas/**/*.js",
    "workspaceContains:Schemas/**/*.js",
    "workspaceContains:conf/content/*.js",
    "workspaceContains:content/*.js",
    "workspaceContains:Resources/ui/BPMSoft/**/*.js",
    "workspaceContains:ui/BPMSoft/**/*.js",
    "workspaceContains:Autogenerated/Src/*.js"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[javascript]": {
        "editor.wordBasedSuggestions": "off",
        "editor.suggestSelection": "first",
        "editor.suggest.showStatusBar": false,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        },
        "javascript.suggest.names": false,
        "javascript.suggestionActions.enabled": false
      },
      "[csharp]": {
        "editor.quickSuggestions": {
          "strings": true
        }
      }
    },
    "commands": [
      {
        "command": "bpmsoft.rebuildIndex",
        "title": "Rebuild Index",
        "category": "BPMSoft",
        "icon": "$(sync)"
      },
      {
        "command": "bpmsoft.namingIssues.refresh",
        "title": "Rebuild Naming Issues",
        "category": "BPMSoft",
        "icon": "$(checklist)"
      },
      {
        "command": "bpmsoft.naming.markFalsePositive",
        "title": "Пометить как ложное срабатывание (игнорировать это имя во всех проверках нейминга)",
        "category": "BPMSoft",
        "icon": "$(circle-slash)"
      },
      {
        "command": "bpmsoft.setDefaultFormatter",
        "title": "Set as Default Formatter (JS/C#/SQL)",
        "category": "BPMSoft"
      },
      {
        "command": "bpmsoft.formatting.showHelp",
        "title": "О разделе Formatting",
        "category": "BPMSoft",
        "icon": "$(info)"
      },
      {
        "command": "bpmsoft.packageSettings.showHelp",
        "title": "О разделе Package Settings",
        "category": "BPMSoft",
        "icon": "$(info)"
      },
      {
        "command": "bpmsoft.envConfig.refresh",
        "title": "Обновить Config Files",
        "category": "BPMSoft",
        "icon": "$(refresh)"
      },
      {
        "command": "bpmsoft.envConfig.showHelp",
        "title": "О разделе Config Files",
        "category": "BPMSoft",
        "icon": "$(info)"
      },
      {
        "command": "bpmsoft.devMode.refresh",
        "title": "Обновить Dev Mode",
        "category": "BPMSoft",
        "icon": "$(refresh)"
      },
      {
        "command": "bpmsoft.devMode.showHelp",
        "title": "О разделе Dev Mode",
        "category": "BPMSoft",
        "icon": "$(info)"
      },
      {
        "command": "bpmsoft.feedback.showHelp",
        "title": "О разделе Обратная связь",
        "category": "BPMSoft",
        "icon": "$(info)"
      },
      {
        "command": "bpmsoft.editLocalizedStrings",
        "title": "Редактировать локализуемые строки…",
        "category": "BPMSoft",
        "icon": "$(globe)"
      },
      {
        "command": "bpmsoft.editLocalizedImages",
        "title": "Редактировать локализуемые изображения…",
        "category": "BPMSoft",
        "icon": "$(file-media)"
      },
      {
        "command": "bpmsoft.schemaHistory.openDiff",
        "title": "Показать изменения коммита",
        "category": "BPMSoft"
      },
      {
        "command": "bpmsoft.schemaHistory.openCommit",
        "title": "Открыть коммит целиком",
        "category": "BPMSoft",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "bpmsoft.schemaHistory.refresh",
        "title": "Обновить Timeline",
        "category": "BPMSoft",
        "icon": "$(refresh)"
      },
      {
        "command": "bpmsoft.schemaHistory.pin",
        "title": "Timeline: закрепить текущий файл",
        "category": "BPMSoft",
        "icon": "$(pin)"
      },
      {
        "command": "bpmsoft.schemaHistory.unpin",
        "title": "Timeline: открепить",
        "category": "BPMSoft",
        "icon": "$(pinned)"
      },
      {
        "command": "bpmsoft.schemaHistory.toggleGitHistory",
        "title": "Git History",
        "category": "BPMSoft",
        "toggled": "bpmsoftSchemaHistoryGitEnabled"
      },
      {
        "command": "bpmsoft.schemaHistory.toggleLocalHistory",
        "title": "Local History",
        "category": "BPMSoft",
        "toggled": "bpmsoftSchemaHistoryLocalEnabled"
      },
      {
        "command": "bpmsoft.schemaHistory.findLocalHistory",
        "title": "Local History: найти запись для восстановления…",
        "category": "BPMSoft",
        "icon": "$(history)"
      },
      {
        "command": "bpmsoft.viewModelOutline.toggleFollowCursor",
        "title": "Следовать за курсором",
        "category": "BPMSoft",
        "toggled": "bpmsoftViewModelOutlineFollowCursor"
      },
      {
        "command": "bpmsoft.plainOutline.toggleFollowCursor",
        "title": "Следовать за курсором",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineFollowCursor"
      },
      {
        "command": "bpmsoft.plainOutline.toggleFilterOnType",
        "title": "Фильтрация при вводе",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineFilterOnType"
      },
      {
        "command": "bpmsoft.plainOutline.sortByPosition",
        "title": "По позиции",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineSortPosition"
      },
      {
        "command": "bpmsoft.plainOutline.sortByName",
        "title": "По имени",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineSortName"
      },
      {
        "command": "bpmsoft.plainOutline.sortByCategory",
        "title": "По категории",
        "category": "BPMSoft",
        "toggled": "bpmsoftPlainOutlineSortCategory"
      },
      {
        "command": "bpmsoftFormatting.focus",
        "title": "Focus on Formatting View",
        "category": "BPMSoft Settings"
      },
      {
        "command": "bpmsoftPackageSettings.focus",
        "title": "Focus on Package Settings View",
        "category": "BPMSoft Settings"
      },
      {
        "command": "bpmsoftDevMode.focus",
        "title": "Focus on Dev Mode View",
        "category": "BPMSoft Settings"
      },
      {
        "command": "bpmsoftEnvConfig.focus",
        "title": "Focus on Config Files View",
        "category": "BPMSoft Settings"
      },
      {
        "command": "bpmsoftViewModelOutline.focus",
        "title": "Focus on ViewModel Outline View",
        "category": "BPMSoft Explorer"
      },
      {
        "command": "bpmsoftPlainOutline.focus",
        "title": "Focus on Outline View",
        "category": "BPMSoft Explorer"
      },
      {
        "command": "bpmsoftSchemaHistory.focus",
        "title": "Focus on Timeline View",
        "category": "BPMSoft Explorer"
      },
      {
        "command": "bpmsoftOpenSchemas.focus",
        "title": "Focus on Open Schemas View",
        "category": "BPMSoft Explorer"
      },
      {
        "command": "bpmsoftPackages.focus",
        "title": "Focus on Packages View",
        "category": "BPMSoft Explorer"
      },
      {
        "command": "bpmsoftNamingIssues.focus",
        "title": "Focus on Naming Issues View",
        "category": "BPMSoft Explorer"
      }
    ],
    "submenus": [
      {
        "id": "bpmsoft.schemaHistory.filterMenu",
        "label": "Источники Timeline",
        "icon": "$(filter)"
      },
      {
        "id": "bpmsoft.schemaHistory.moreActionsMenu",
        "label": "Дополнительно",
        "icon": "$(ellipsis)"
      },
      {
        "id": "bpmsoft.viewModelOutline.actionsMenu",
        "label": "Дополнительно",
        "icon": "$(ellipsis)"
      },
      {
        "id": "bpmsoft.plainOutline.actionsMenu",
        "label": "Дополнительно",
        "icon": "$(ellipsis)"
      },
      {
        "id": "bpmsoft.plainOutline.sortByMenu",
        "label": "Сортировка"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bpmsoftFormatting.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftPackageSettings.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftDevMode.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftEnvConfig.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftViewModelOutline.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftPlainOutline.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftSchemaHistory.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftOpenSchemas.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftPackages.focus",
          "when": "false"
        },
        {
          "command": "bpmsoftNamingIssues.focus",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "bpmsoft.schemaHistory.pin",
          "when": "view == bpmsoftSchemaHistory && !bpmsoftSchemaHistoryPinned",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.schemaHistory.unpin",
          "when": "view == bpmsoftSchemaHistory && bpmsoftSchemaHistoryPinned",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.schemaHistory.refresh",
          "when": "view == bpmsoftSchemaHistory",
          "group": "navigation@2"
        },
        {
          "submenu": "bpmsoft.schemaHistory.filterMenu",
          "when": "view == bpmsoftSchemaHistory",
          "group": "navigation@3"
        },
        {
          "submenu": "bpmsoft.schemaHistory.moreActionsMenu",
          "when": "view == bpmsoftSchemaHistory",
          "group": "navigation@4"
        },
        {
          "submenu": "bpmsoft.viewModelOutline.actionsMenu",
          "when": "view == bpmsoftViewModelOutline",
          "group": "navigation@1"
        },
        {
          "submenu": "bpmsoft.plainOutline.actionsMenu",
          "when": "view == bpmsoftPlainOutline",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.rebuildIndex",
          "when": "view == bpmsoftPackageSettings",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.namingIssues.refresh",
          "when": "view == bpmsoftPackageSettings",
          "group": "navigation@2"
        },
        {
          "command": "bpmsoft.packageSettings.showHelp",
          "when": "view == bpmsoftPackageSettings",
          "group": "navigation@3"
        },
        {
          "command": "bpmsoft.formatting.showHelp",
          "when": "view == bpmsoftFormatting",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.rebuildIndex",
          "when": "view == bpmsoftPackages",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.namingIssues.refresh",
          "when": "view == bpmsoftPackages",
          "group": "navigation@2"
        },
        {
          "command": "bpmsoft.namingIssues.refresh",
          "when": "view == bpmsoftNamingIssues",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.envConfig.refresh",
          "when": "view == bpmsoftEnvConfig",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.envConfig.showHelp",
          "when": "view == bpmsoftEnvConfig",
          "group": "navigation@2"
        },
        {
          "command": "bpmsoft.devMode.refresh",
          "when": "view == bpmsoftDevMode",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.devMode.showHelp",
          "when": "view == bpmsoftDevMode",
          "group": "navigation@2"
        },
        {
          "command": "bpmsoft.feedback.showHelp",
          "when": "view == bpmsoftFeedback",
          "group": "navigation@1"
        }
      ],
      "bpmsoft.viewModelOutline.actionsMenu": [
        {
          "command": "bpmsoft.viewModelOutline.toggleFollowCursor",
          "group": "1_navigation@1"
        }
      ],
      "bpmsoft.plainOutline.actionsMenu": [
        {
          "command": "bpmsoft.plainOutline.toggleFollowCursor",
          "group": "1_navigation@1"
        },
        {
          "command": "bpmsoft.plainOutline.toggleFilterOnType",
          "group": "1_navigation@2"
        },
        {
          "submenu": "bpmsoft.plainOutline.sortByMenu",
          "group": "2_sort@1"
        }
      ],
      "bpmsoft.plainOutline.sortByMenu": [
        {
          "command": "bpmsoft.plainOutline.sortByPosition",
          "group": "1_sortBy@1"
        },
        {
          "command": "bpmsoft.plainOutline.sortByName",
          "group": "1_sortBy@2"
        },
        {
          "command": "bpmsoft.plainOutline.sortByCategory",
          "group": "1_sortBy@3"
        }
      ],
      "bpmsoft.schemaHistory.filterMenu": [
        {
          "command": "bpmsoft.schemaHistory.toggleGitHistory",
          "group": "1_sources@1"
        },
        {
          "command": "bpmsoft.schemaHistory.toggleLocalHistory",
          "group": "1_sources@2"
        }
      ],
      "bpmsoft.schemaHistory.moreActionsMenu": [
        {
          "command": "bpmsoft.schemaHistory.findLocalHistory",
          "group": "1_localHistory@1"
        }
      ],
      "view/item/context": [
        {
          "command": "bpmsoft.schemaHistory.openCommit",
          "when": "view == bpmsoftSchemaHistory && viewItem == bpmsoftHistoryCommit",
          "group": "inline"
        },
        {
          "command": "bpmsoft.naming.markFalsePositive",
          "when": "view == bpmsoftNamingIssues && viewItem == bpmsoftNamingFinding",
          "group": "inline"
        },
        {
          "command": "bpmsoft.editLocalizedStrings",
          "when": "view == bpmsoftPackages && viewItem == bpmsoftSchema",
          "group": "1_localization@1"
        },
        {
          "command": "bpmsoft.editLocalizedImages",
          "when": "view == bpmsoftPackages && viewItem == bpmsoftSchema",
          "group": "1_localization@2"
        }
      ],
      "editor/context": [
        {
          "command": "bpmsoft.editLocalizedStrings",
          "when": "bpmsoftActiveSchema",
          "group": "1_bpmsoft@1"
        },
        {
          "command": "bpmsoft.editLocalizedImages",
          "when": "bpmsoftActiveSchemaIsJs",
          "group": "1_bpmsoft@2"
        }
      ],
      "editor/title": [
        {
          "command": "bpmsoft.editLocalizedStrings",
          "when": "bpmsoftActiveSchema",
          "group": "navigation@1"
        },
        {
          "command": "bpmsoft.editLocalizedImages",
          "when": "bpmsoftActiveSchemaIsJs",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": [
      {
        "title": "BPMSoft Toolkit: Индексация и подсказки",
        "properties": {
          "bpmsoft.pkgGlob": {
            "type": "string",
            "default": "**/Pkg/**/Schemas/**/*.js",
            "description": "Glob JS-схем пакетов. Нужен только если расширение не нашло стандартный layout установки."
          },
          "bpmsoft.autogeneratedGlob": {
            "type": "string",
            "default": "**/Autogenerated/Src/*.js",
            "description": "Glob автосгенерированных схем (SchemaName.Package.js). Только fallback-индексация."
          },
          "bpmsoft.platformUiGlob": {
            "type": "string",
            "default": "**/Resources/ui/BPMSoft/**/*.js",
            "description": "Glob платформенных Ext-классов (BPMSoft.controls.Grid и т.п.). Только fallback."
          },
          "bpmsoft.enablePlatformStubs": {
            "type": "boolean",
            "default": true,
            "description": "Добавлять статические подсказки BPMSoft.* (enums, частые API) к индексу проекта."
          },
          "bpmsoft.preferIndexedCompletions": {
            "type": "boolean",
            "default": true,
            "description": "Отключать словарные подсказки JS в workspace, чтобы первыми шли индексированные BPMSoft."
          },
          "bpmsoft.enumInlayHints": {
            "type": "boolean",
            "default": true,
            "description": "Подсказки прямо в коде: числовой enum → BPMSoft.*, краткое описание бизнес-правила."
          }
        }
      },
      {
        "title": "BPMSoft Toolkit: Стиль и формат",
        "properties": {
          "bpmsoft.styleDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Проверять стиль JS и C#. JS: не Autogenerated/UI/conf; C#: в том числе Autogenerated/Src."
          },
          "bpmsoft.csharpXmlDocDiagnostics": {
            "type": "boolean",
            "default": false,
            "description": "Предупреждать, если у public/protected метода или свойства C# нет /// комментария. По умолчанию выкл. — в существующих пакетах покрытия почти нет."
          },
          "bpmsoft.trailingCommentDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Предупреждать о // в конце строки: комментарий должен быть на строке выше."
          },
          "bpmsoft.selectAllColumnsHint": {
            "type": "boolean",
            "default": true,
            "description": "Подсказка, если выбираются все колонки (AddAllSchemaColumns / esq.allColumns). Глушится комментарием // bpmsoft-ignore: select-all-columns."
          },
          "bpmsoft.formatting.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Форматировать JS/C#/SQL-скрипты пакета через Format Document. Выключите, если используете другой форматтер."
          }
        }
      },
      {
        "title": "BPMSoft Toolkit: Нейминг",
        "properties": {
          "bpmsoft.namingDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Проверять имена клиентских схем и SQL-скриптов по гайдлайну (суффиксы Page/Section/Detail, Css-модули, временные New/Test/Temp). Главный выключатель нейминга."
          },
          "bpmsoft.namingPrefixes": {
            "type": "string",
            "default": "",
            "description": "Префиксы пакетов и схем через запятую (Nau или Nau,Go). Пусто — префикс не проверяется."
          },
          "bpmsoft.entityNamingDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Проверять объекты: код, заголовки ru/en, колонки, уникальность кода с учётом замещения."
          },
          "bpmsoft.entityNaming.checkSingularName": {
            "type": "boolean",
            "default": true,
            "description": "Ругать код объекта, похожий на множественное число. Шумная эвристика, можно выключить отдельно."
          },
          "bpmsoft.entityNaming.singularExceptions": {
            "type": "string",
            "default": "Settings,Permissions,Statistics",
            "description": "Коды объектов, которым множественное число разрешено (Settings,Permissions,Statistics)."
          },
          "bpmsoft.entityNaming.dateSuffixes": {
            "type": "string",
            "default": "On,Date",
            "description": "Допустимые суффиксы колонок даты (On,Date → CreatedOn, StartDate)."
          },
          "bpmsoft.entityNaming.booleanPrefixes": {
            "type": "string",
            "default": "Is,Has,Can",
            "description": "Допустимые префиксы булевых колонок (Is,Has,Can)."
          },
          "bpmsoft.sqlTempScriptMaxAgeDays": {
            "type": "number",
            "default": 30,
            "description": "Через сколько дней _Temp SQL-скрипт считается забытым (по дате git). 0 — не проверять."
          },
          "bpmsoft.processNamingDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Проверять бизнес-процессы: код, заголовки, названия элементов на диаграмме."
          },
          "bpmsoft.processUserTaskNamingDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Проверять UserTask: суффикс UserTask, глагол в коде, заголовки, имена параметров."
          },
          "bpmsoft.processUserTask.actionVerbs": {
            "type": "string",
            "default": "Add,Apply,Assign,Build,Calculate,Call,Cancel,Change,Check,Clear,Clone,Close,Complete,Confirm,Convert,Create,Delete,Disable,Enable,Execute,Export,Find,Generate,Get,Import,Load,Log,Merge,Move,Normalize,Notify,Parse,Process,Publish,Read,Register,Reject,Reload,Remove,Reset,Run,Save,Search,Send,Set,Show,Split,Start,Stop,Sync,Unregister,Update,Validate,Verify,Write",
            "description": "Глаголы, с которых должен начинаться код UserTask после префикса."
          },
          "bpmsoft.dataNamingDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Проверять данные: код от имени таблицы, без GUID в имени, пара SysSettings ↔ SysSettingsValue."
          },
          "bpmsoft.csharpNamingDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Проверять C# в Schemas/: префикс, Service/EventListener по маркеру платформы, имя класса = код схемы."
          },
          "bpmsoft.csharpNaming.roleSuffixes": {
            "type": "string",
            "default": "Service,EventListener,Helper,Utils,Manager,Handler,Repository,Client,Connector,Job,Process",
            "description": "Суффиксы ролей для проверки склеивания (ServiceHelper и т.п.)."
          },
          "bpmsoft.naming.ignoredNames": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "Имена, исключённые из всех проверок нейминга. Заполняется действием «Пометить как ложное срабатывание»."
          }
        }
      },
      {
        "title": "BPMSoft Toolkit: Git Flow и пакет",
        "properties": {
          "bpmsoft.gitFlowDiagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Проверять имя текущей ветки по Git Flow. Результат — в статус-баре."
          },
          "bpmsoft.gitFlow.mainBranch": {
